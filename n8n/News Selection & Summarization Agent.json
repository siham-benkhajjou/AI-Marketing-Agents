      "parameters": {
        "jsCode": "return [\n  {\n    json: {\n      article_id: \"art_001\",\n      title: \"OpenAI Releases GPT-5.2 with Major Reasoning Improvements\",\n      url: \"https://example.com/openai-gpt-5-2\",\n      source: \"TechCrunch\",\n      published_date: \"2026-09-10\",\n      raw_content: \"OpenAI announced today the release of GPT-5.2, featuring significant improvements in multi-step reasoning and reduced hallucination rates. The model shows a 15% improvement on benchmark tests compared to its predecessor. Early access is being rolled out to enterprise customers this week, with general availability expected next month.\"\n    }\n  },\n  {\n    json: {\n      article_id: \"art_002\",\n      title: \"Google Unveils Custom AI Chip for Data Centers\",\n      url: \"https://example.com/google-ai-chip\",\n      source: \"The Verge\",\n      published_date: \"2026-09-11\",\n      raw_content: \"Google's new Tensor Processing Unit, the TPU v6, promises 40% better performance per watt compared to previous generations. The chip is designed specifically for training large language models and will be available to Google Cloud customers starting in Q1 next year. Analysts say this move intensifies competition with Nvidia in the AI hardware space.\"\n    }\n  },\n  {\n    json: {\n      article_id: \"art_003\",\n      title: \"Startup Raises $200M to Build AI Legal Assistant\",\n      url: \"https://example.com/legal-ai-funding\",\n      source: \"VentureBeat\",\n      published_date: \"2026-09-11\",\n      raw_content: \"LegalMind, a startup building AI tools for contract review and legal research, announced a $200 million Series C round led by Sequoia Capital. The company claims its platform can reduce contract review time by 70% for corporate legal teams. This brings LegalMind's total funding to $350 million since its founding in 2023.\"\n    }\n  },\n  {\n    json: {\n      article_id: \"art_004\",\n      title: \"EU Proposes New AI Transparency Requirements\",\n      url: \"https://example.com/eu-ai-regulation\",\n      source: \"Reuters\",\n      published_date: \"2026-09-09\",\n      raw_content: \"The European Commission has proposed new rules requiring AI companies to disclose training data sources for models deployed within the EU. The proposal, part of an update to the AI Act, would apply to any foundation model with over 1 billion parameters. Industry groups have expressed concern about compliance costs, while consumer advocates have welcomed the move.\"\n    }\n  },\n  {\n    json: {\n      article_id: \"art_005\",\n      title: \"New Browser Extension Uses AI to Summarize Long Articles\",\n      url: \"https://example.com/ai-browser-extension\",\n      source: \"Product Hunt Blog\",\n      published_date: \"2026-09-08\",\n      raw_content: \"A new Chrome extension called SumUp uses a lightweight language model to generate one-paragraph summaries of any article as you browse. The tool has gained 50,000 users since launching two weeks ago. It's a minor update to an existing productivity tool category, with several similar extensions already on the market.\"\n    }\n  }\n];"
      },
