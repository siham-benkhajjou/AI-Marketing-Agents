    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const keywords = [\n  \"ai\", \"artificial intelligence\", \"machine learning\", \"ml\",\n  \"llm\", \"large language model\", \"gpt\", \"chatgpt\", \"openai\",\n  \"deep learning\", \"neural network\", \"generative ai\", \"genai\",\n  \"anthropic\", \"claude\", \"gemini\", \"copilot\", \"transformer model\"\n];\n\nconst title = ($json.title || \"\").toLowerCase();\nconst content = ($json.raw_content || \"\").toLowerCase();\nconst combinedText = title + \" \" + content;\n\nconst isAIRelated = keywords.some(keyword => combinedText.includes(keyword));\n\nreturn {\n  json: {\n    ...$json,\n    is_ai_related: isAIRelated\n  }\n};"
      },
