    {
      "parameters": {
        "jsCode": "function normalizeTitle(title) {\n  return (title || \"\")\n    .toLowerCase()\n    .replace(/[^\\w\\s]/g, \"\")\n    .split(\" \")\n    .filter(w => w.length > 3); // ignore short filler words\n}\n\nfunction similarity(wordsA, wordsB) {\n  const setA = new Set(wordsA);\n  const setB = new Set(wordsB);\n  const intersection = [...setA].filter(w => setB.has(w));\n  const union = new Set([...setA, ...setB]);\n  return intersection.length / union.size; // Jaccard similarity, 0 to 1\n}\n\nconst items = $input.all();\nconst kept = [];\nconst SIMILARITY_THRESHOLD = 0.5;\n\nfor (const item of items) {\n  const wordsA = normalizeTitle(item.json.title);\n  const isDuplicate = kept.some(existing => {\n    const wordsB = normalizeTitle(existing.json.title);\n    return similarity(wordsA, wordsB) >= SIMILARITY_THRESHOLD;\n  });\n\n  if (!isDuplicate) {\n    kept.push(item);\n  }\n}\n\nreturn kept;"
      },
