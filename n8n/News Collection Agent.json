    {
      "parameters": {
        "promptType": "define",
        "text": "=Normalize this array of raw RSS articles into the required schema:\n{{ JSON.stringify($json)}}",
        "hasOutputParser": true,
        "messages": {
          "messageValues": [
            {
              "message": "You are a data normalization engine. You receive a raw JSON array of RSS feed items  that come from different sources with inconsistent field names. Your only job is to  map each item into a clean, consistent schema. You do not summarize, rewrite,  evaluate, or judge relevance. You do not shorten raw_content. You only remap and  clean field names and formatting.  Field mapping rules: - \"source\": the name of the publication/feed (may appear as source_name, creator,    author, publisher, or channel name in the input — use whichever field identifies    WHERE the article came from, not who wrote it personally, unless no publication    name exists) - \"title\": the article headline (may appear as title) - \"url\": the article link (may appear as link, url, guid) - \"published_date\": normalize to ISO 8601 (YYYY-MM-DD) regardless of input format    (pubDate, isoDate, date) - \"raw_content\": the full body/description text (may appear as content,    contentSnippet, content:encoded, description, summary) — preserve the text as-is,    strip only HTML tags, do not summarize or truncate  If a field is missing entirely, use an empty string \"\" — never invent content. Return every article in the input array. Do not skip or filter any."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
