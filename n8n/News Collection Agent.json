      "webhookId": "b91a7a65-7be8-46e6-9c83-e27445952821"
    },
    {
      "parameters": {
        "amount": 30
      },
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        -432,
        304
      ],
      "id": "ecf1b735-8b06-425c-a6d3-c5b6abffe3e0",
      "name": "Wait 30sec",
      "webhookId": "b91a7a65-7be8-46e6-9c83-e27445952821"
    },
    {
      "parameters": {
        "jsCode": "\nconst seen = new Set();\nconst rows = [];\n\nfor (const item of $input.all()) {\n  const articles = item.json?.output?.articles ?? [];\n  for (const a of articles) {\n    const url = (a.url || '').trim();\n    if (!url || seen.has(url)) continue;   // no URL = no ID, and dedupe inside this run\n    seen.add(url);\n\n    // Postgres DATE rejects '' -> fall back to today if the LLM gave a bad date\n    let date = String(a.published_date || '').slice(0, 10);\n    if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date)) date = new Date().toISOString().slice(0, 10);\n\n    rows.push({\n      json: {\n        title: (a.title || '').trim(),\n        url,\n        source: (a.source || '').trim(),\n        published_date: date,\n        raw_content: (a.raw_content || '').trim(),\n      },\n    });\n  }\n}\n\nreturn rows;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -672,
        0
      ],
      "id": "5a8c6820-36c7-49e4-93a2-f5cc8b0e329e",
      "name": "Flatten & Clean Articles"
    },
    {
      "parameters": {
        "value": "={{ $json.url }}",
        "dataPropertyName": "article_id"
      },
      "type": "n8n-nodes-base.crypto",
      "typeVersion": 1,
      "position": [
        -464,
        0
      ],
      "id": "8b6c2f8b-aa1b-4420-b89f-707051d54467",
      "name": "Generate article_id"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO raw_articles (article_id, title, url, source, published_date, raw_content)\nVALUES ($1, $2, $3, $4, $5, $6)\nON CONFLICT (article_id) DO UPDATE SET collected_at = raw_articles.collected_at\nRETURNING *;",
        "options": {
          "queryReplacement": "={{ [ $json.article_id, $json.title, $json.url, $json.source, $json.published_date, $json.raw_content ] }}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        -256,
        0
      ],
      "id": "bf9630fb-380e-4f82-bdd3-fe32e84d1200",
      "name": "Save to raw_articles",
      "alwaysOutputData": false,
      "credentials": {
        "postgres": {
          "id": "6d2qLnvqDcFhVDRd",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const r = item.json;\n  const d = r.published_date;\n  return {\n    json: {\n      article_id: r.article_id,\n      title: r.title,\n      url: r.url,\n      source: r.source,\n      published_date: d instanceof Date ? d.toISOString().slice(0, 10) : String(d ?? '').slice(0, 10),\n      raw_content: r.raw_content,\n    },\n  };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -48,
        0
      ],
      "id": "718ebd3a-79e0-48fb-830d-bfdf0771518c",
